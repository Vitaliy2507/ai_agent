export GIGACHAT_CLIENT_ID="your-client-id"

export GIGACHAT_CLIENT_SECRET="your-client-secret"

export GIGACHAT_SCOPE="GIGACHAT_API_PERS"

export GIGACHAT_MODEL="GigaChat"

export GIGACHAT_VERIFY_SSL="false"

export GIGACHAT_CA_BUNDLE=""



# --- Jira ---

export JIRA_BASE_URL="https://jira.sberbank.ru"

export JIRA_API_TOKEN="your-api-token"

export JIRA_USE_BEARER_AUTH="true"




# --- Bitbucket ---

export BITBUCKET_BASE_URL="https://stash.delta.sbrf.ru"

export BITBUCKET_USERNAME="your-username"

export BITBUCKET_APP_PASSWORD="your-app-password"



# --- Маппинг Labels → репозитории ---

export BITBUCKET_REPO_MAPPING="LABEL1:WORKSPACE1:REPO1:BRANCH1:/path/to/repo1,LABEL2:WORKSPACE2:REPO2:BRANCH2:/path/to/repo2"



# --- Fallback ---

export BITBUCKET_FALLBACK_WORKSPACE="your-workspace"

export BITBUCKET_FALLBACK_REPO_SLUG="your-repo"

export BITBUCKET_FALLBACK_MAIN_BRANCH="develop"

export BITBUCKET_FALLBACK_REPO_PATH="/path/to/fallback/repo"
